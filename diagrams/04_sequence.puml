@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam roundcorner 8
skinparam ArrowColor #333333
skinparam ClassBackgroundColor #F5F9FF
skinparam ClassBorderColor #2F5597

title Диаграмма последовательности: оформление и оплата заказа
actor Клиент
participant "Веб-клиент" as W
participant "Контроллер\nзаказов" as K
participant "Сервис\nзаказов" as S
participant "Сервис\nплатежей" as P
participant "Сервис\nлицензий" as L
database "БД" as D
participant "Платёжная\nсистема" as E
Клиент -> W : нажать «Оформить заказ»
W -> K : POST /orders (корзина)
activate K
K -> S : создатьЗаказ(клиент, позиции)
activate S
S -> D : INSERT Заказ, ПозицияЗаказа
D --> S : id заказа
S --> K : Заказ (НОВЫЙ)
deactivate S
K --> W : данные заказа, сумма
deactivate K
Клиент -> W : выбрать способ оплаты
W -> K : POST /orders/{id}/pay
activate K
K -> P : оплатить(заказ)
activate P
P -> E : запрос оплаты (сумма)
E --> P : результат
alt оплата успешна
  P -> D : INSERT Платёж, статус ОПЛАЧЕН
  P -> L : выдатьЛицензии(заказ)
  activate L
  L -> D : INSERT Лицензия (ключи)
  L --> P : ключи
  deactivate L
  P --> K : успех
  K --> W : ключи и чек
  W --> Клиент : отобразить лицензии
else отказ в оплате
  P --> K : ошибка
  K --> W : сообщение об ошибке
  W --> Клиент : предложить повторить
end
deactivate P
deactivate K
@enduml
