@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam roundcorner 8
skinparam ArrowColor #333333
skinparam ClassBackgroundColor #F5F9FF
skinparam ClassBorderColor #2F5597

skinparam componentStyle rectangle
title Архитектура ИС «Программные продукты» (трёхуровневая)
package "Уровень представления" {
  [Веб-клиент\n(каталог, корзина, кабинет)] as Web
  [Панель менеджера] as Mgr
  [Панель администратора] as Adm
}
package "Уровень бизнес-логики (REST API)" {
  [Контроллеры API] as Ctl
  [Сервис каталога] as Cat
  [Сервис заказов] as Ord
  [Сервис лицензий] as Lic
  [Сервис платежей] as Pay
  [Сервис пользователей\nи авторизации] as Usr
}
package "Уровень данных" {
  [Репозитории\n(ORM)] as Repo
  database "MS SQL Server\nSoftwareProductsDB" as DB
}
cloud "Внешняя платёжная система" as Ext
Web --> Ctl : HTTPS / JSON
Mgr --> Ctl
Adm --> Ctl
Ctl --> Cat
Ctl --> Ord
Ctl --> Usr
Ord --> Lic
Ord --> Pay
Cat --> Repo
Ord --> Repo
Lic --> Repo
Pay --> Repo
Usr --> Repo
Repo --> DB : SQL
Pay ..> Ext : запрос оплаты
@enduml
