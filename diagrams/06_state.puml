@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam roundcorner 8
skinparam ArrowColor #333333
skinparam ClassBackgroundColor #F5F9FF
skinparam ClassBorderColor #2F5597

title Диаграмма состояний объекта «Заказ»
[*] --> Новый : создан из корзины
Новый --> Оплачен : оплата подтверждена
Новый --> Отменён : отмена клиентом /\nистёк срок оплаты
Оплачен --> Выполняется : менеджер принял в работу
Выполняется --> Завершён : лицензии выданы
Выполняется --> Отменён : возврат средств
Завершён --> [*]
Отменён --> [*]
state Выполняется {
  [*] --> ПроверкаНаличия
  ПроверкаНаличия --> ГенерацияКлючей : продукт доступен
  ГенерацияКлючей --> [*]
}
@enduml
