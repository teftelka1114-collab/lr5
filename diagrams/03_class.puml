@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 150
skinparam shadowing false
skinparam backgroundColor white
skinparam roundcorner 8
skinparam ArrowColor #333333
skinparam ClassBackgroundColor #F5F9FF
skinparam ClassBorderColor #2F5597

hide empty members
title Диаграмма классов
class Пользователь {
  - id : int
  - логин : string
  - хэшПароля : string
  - email : string
  - роль : РольПользователя
  + авторизоваться() : bool
  + сменитьПароль(новый : string) : void
}
class Клиент {
  - телефон : string
  - датаРегистрации : date
  + добавитьВКорзину(п : ПрограммныйПродукт, кол : int) : void
  + оформитьЗаказ() : Заказ
}
class Сотрудник {
  - должность : string
  + изменитьСтатусЗаказа(з : Заказ, с : СтатусЗаказа) : void
}
class ПрограммныйПродукт {
  - id : int
  - название : string
  - версия : string
  - цена : decimal
  - описание : string
  - типЛицензии : ТипЛицензии
  + изменитьЦену(цена : decimal) : void
  + доступен() : bool
}
class Категория {
  - id : int
  - название : string
}
class Разработчик {
  - id : int
  - название : string
  - страна : string
}
class Заказ {
  - id : int
  - дата : datetime
  - статус : СтатусЗаказа
  + рассчитатьСумму() : decimal
  + отменить() : void
}
class ПозицияЗаказа {
  - количество : int
  - ценаНаМоментПокупки : decimal
  + стоимость() : decimal
}
class Платёж {
  - id : int
  - сумма : decimal
  - дата : datetime
  - способ : string
  - статус : string
  + провести() : bool
}
class Лицензия {
  - ключ : string
  - датаВыдачи : date
  - срокДействия : date
  + активировать() : bool
  + действительна() : bool
}
enum РольПользователя {
  КЛИЕНТ
  МЕНЕДЖЕР
  АДМИНИСТРАТОР
}
enum ТипЛицензии {
  БЕССРОЧНАЯ
  ПОДПИСКА
}
enum СтатусЗаказа {
  НОВЫЙ
  ОПЛАЧЕН
  ВЫПОЛНЯЕТСЯ
  ЗАВЕРШЁН
  ОТМЕНЁН
}
Пользователь <|-- Клиент
Пользователь <|-- Сотрудник
Клиент "1" -- "0..*" Заказ : оформляет
Сотрудник "0..1" -- "0..*" Заказ : обрабатывает
Заказ "1" *-- "1..*" ПозицияЗаказа : состоит из
ПозицияЗаказа "0..*" --> "1" ПрограммныйПродукт
Заказ "1" -- "0..1" Платёж : оплачивается
ПозицияЗаказа "1" -- "0..*" Лицензия : порождает
Клиент "1" -- "0..*" Лицензия : владеет
Категория "1" o-- "0..*" ПрограммныйПродукт
Разработчик "1" o-- "0..*" ПрограммныйПродукт : выпускает
Заказ ..> СтатусЗаказа
@enduml
